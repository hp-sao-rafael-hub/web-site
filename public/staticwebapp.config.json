{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/", "redirect": "/pt", "statusCode": 302 }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/images/*", "*.{css,js,png,jpg,jpeg,gif,svg,webp,avif,ico,woff,woff2,txt,xml,json}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
