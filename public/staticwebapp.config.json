{
  "routes": [
    {
      "route": "/",
      "redirect": "/pt/",
      "statusCode": 301
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/pt/index.html",
    "exclude": ["/_next/*", "/assets/*", "/images/*", "/fonts/*", "/para-cirurgioes-parceiros/*", "/*.{png,jpg,jpeg,gif,svg,webp,avif,ico,css,js,json,xml,txt,woff,woff2,otf}"]
  }
}
